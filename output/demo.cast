[2.006, "o", "\r\n################################################################\r\n## 6/6 旧接口零回归:解码与 seek 不受影响\r\n################################################################\r\n\r\n$ /home/ys/feedback/uidreczz28Z0d8oUJJr/unix/opusfile_example /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus\r\n"]
