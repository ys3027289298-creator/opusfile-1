[2.004, "o", "\r\n################################################################\r\n## 4/6 往返一致:读回标签,封面字节逐一相同,音频不变\r\n################################################################\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "$ /home/ys/feedback/uidreczz28Z0d8oUJJr/unix/tagging_example /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus --dump-picture=/home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/roundtrip.png\r\n"]
[0.001, "o", "Vendor: Lavf61.1.100\r\nComments: 4\r\n  encoder=Lavc61.3.100 libopus\r\n  TITLE=Round Trip\r\n  ARTIST=opusfile\r\n  METADATA_BLOCK_PICTURE: type=3 mime=\"image/png\" description=\"\" 32x32x24 colors=0 data=120 bytes"]
[0.001, "o", " [PNG]"]
[0.000, "o", "\r\n"]
[0.000, "o", "\r\n$ cmp /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/cover.png /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/roundtrip.png\r\n"]
[0.003, "o", "封面原始字节一致 (cmp 无输出)\r\n\r\n$ md5sum 解码PCM(写标签前后)\r\n"]
