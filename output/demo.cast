[0.008, "o", "\r\n################################################################\r\n## 1/6 构建:用仓库自带 unix/Makefile 编译库和示例\r\n################################################################\r\n"]
[0.001, "o", "\r\n"]
[0.000, "o", "$ make -C /home/ys/feedback/uidreczz28Z0d8oUJJr/unix -f Makefile CFLAGS=-g -DOP_ENABLE_ASSERTIONS -fPIC -std=c89 -pedantic -Wextra -Wno-parentheses -Wno-long-long -Wall\r\n"]
[0.003, "o", "make: Entering directory '/home/ys/feedback/uidreczz28Z0d8oUJJr/unix'\r\nmake: Nothing to be done for 'all'.\r\nmake: Leaving directory '/home/ys/feedback/uidreczz28Z0d8oUJJr/unix'\r\n"]
[2.008, "o", "\r\n################################################################\r\n## 2/6 造素材:1 秒 opus 音频 + 32x32 PNG 封面(都很小)\r\n################################################################\r\n"]
[0.004, "o", "\r\n$ ffmpeg -hide_banner -loglevel error -f lavfi -i sine=frequency=440:duration=1 -c:a libopus -b:a 24k -y /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus\r\n"]
[0.021, "o", "\r\n$ ffmpeg -hide_banner -loglevel error -f lavfi -i color=c=0x336699:size=32x32 -frames:v 1 -y /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/cover.png\r\n"]
[0.013, "o", "\r\n$ ls -l /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/cover.png\r\n"]
[0.004, "o", "-rw-r--r-- 1 ys ys  120 Nov 13 13:10 /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/cover.png\r\n-rw-r--r-- 1 ys ys 3903 Nov 13 13:10 /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus\r\n"]
[2.006, "o", "\r\n################################################################\r\n## 3/6 归档写入:给 opus 文件写标签和封面\r\n################################################################\r\n\r\n$ /home/ys/feedback/uidreczz28Z0d8oUJJr/unix/tagging_example /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus\r\n"]
[0.002, "o", "Vendor: Lavf61.1.100\r\nComments: 1\r\n  encoder=Lavc61.3.100 libopus\r\n"]
[0.000, "o", "\r\n$ /home/ys/feedback/uidreczz28Z0d8oUJJr/unix/tagging_example /home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/test.opus TITLE=Round Trip ARTIST=opusfile --picture=/home/ys/feedback/uidreczz28Z0d8oUJJr/output/assets/cover.png\r\n"]
